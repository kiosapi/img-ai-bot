# ============================================
#  Image AI Bot — Environment Configuration
#  Copy this file to ".env" and fill in your values:
#     cp .env.example .env
# ============================================

# ---- Telegram ----
# Get from @BotFather on Telegram
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Channel users must join before using the bot (with @). Leave empty to disable.
REQUIRED_CHANNEL=@your_channel
# Your Telegram numeric user ID(s), comma-separated. Get it from @userinfobot
ADMIN_IDS=123456789

# ---- Cubence API (image model) ----
# Get your key from https://cubence.com  (model: gpt-image-2)
CUBENCE_API_KEY=your_cubence_api_key
CUBENCE_BASE_URL=https://api-dmit.cubence.com

# ---- Limits ----
# Default images per user per day (adjustable later from the dashboard)
DEFAULT_DAILY_LIMIT=20

# ---- PostgreSQL ----
POSTGRES_USER=imgbot
# Use a strong random password (e.g. `openssl rand -hex 16`)
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=imgbot

# ---- Admin Dashboard ----
ADMIN_USER=admin
# Strong password for dashboard login
ADMIN_PASS=change_me_admin_password
# Random secret for signing sessions (e.g. `openssl rand -hex 16`)
DASH_SECRET=change_me_random_secret
